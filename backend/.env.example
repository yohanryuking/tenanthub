# Used by Prisma CLI (migrate/studio) — connects as the schema-owning role,
# which is intentionally allowed to bypass RLS so migrations can run freely.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tenanthub_dev"

# Used by the NestJS app at runtime — connects as a non-owner role that RLS
# actually applies to. Never point this at a superuser/table-owner role.
APP_DATABASE_URL="postgresql://tenanthub_app:tenanthub_app@localhost:5432/tenanthub_dev"

JWT_SECRET="dev-only-change-me"
# Access tokens are short-lived on purpose — refresh tokens (opaque,
# rotated on every use, revocable) are what makes that livable. See
# docs/architecture.md.
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=30
PORT=3000
